PORT=5000
MONGODB_URI=mongodb://localhost:27017/bloom-care

# Authentication (see docs/IMPLEMENTATION_DECISIONS.md: JWT sub/role claims, 7-day lifetime, bcrypt work factor 12)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Nearby Pharmacy / Distance (see docs/IMPLEMENTATION_DECISIONS.md Distance Decision):
# used only to resolve a pharmacy's Google Maps shared link to latitude/longitude
# when the pharmacy creates or updates that link — never during visitor search.
GEOAPIFY_API_KEY=replace-with-your-geoapify-api-key

# Allowed frontend origin for CORS. Defaults to the local Vite dev server if unset;
# set this to the deployed frontend's URL in staging/production.
CORS_ORIGIN=http://localhost:5173
